SECOPS_APP_NAME="SecOps Orchestrator"
SECOPS_DEBUG=false
SECOPS_DATABASE_URL=postgresql+asyncpg://secops:secops@localhost:5432/secops
SECOPS_DATABASE_URL_SYNC=postgresql://secops:secops@localhost:5432/secops
SECOPS_REDIS_URL=redis://localhost:6379/0
SECOPS_SCANNER_TIMEOUT=300
SECOPS_SCANNER_MAX_OUTPUT_BYTES=52428800
SECOPS_WORKSPACE_BASE=/tmp/secops-workspaces
SECOPS_ALLOWED_WORKSPACE_ROOT=/tmp/secops-workspaces
SECOPS_MAX_WORKSPACE_SIZE_MB=500
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops
POSTGRES_DB=secops

# Google Mantis Agentic Security Integration (Contract only / no live execution)
SECOPS_MANTIS_ENABLED=false
SECOPS_MANTIS_REVISION=d13c93fb8e9779801711daea0d65fffa133c3b2d
SECOPS_MANTIS_EXECUTION_MODE=disabled

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

    RUN addgroup --system --gid 1000 secops && adduser --system --uid 1000 --ingroup secops --home /home/secops secops && mkdir -p /tmp/secops-workspaces && chown -R secops:secops /tmp/secops-workspaces

COPY backend/pyproject.toml /app/
RUN pip install --no-cache-dir .

COPY backend /app

USER secops

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
